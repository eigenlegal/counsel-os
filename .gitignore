.DS_Store
node_modules/
browse/dist/
runtime/ui/dist/
# The compiled counsel-os binary and the modules `bun run build:runtime`
# generates to embed the UI and the content (packaging spec §3.2).
dist/
runtime/src/generated/
backups/
*.bun-build
config.local.md

# Per-worktree gbrain source pin (kubectl-style context). Machine-specific
# source ID written by /sync-gbrain; each developer generates their own.
.gbrain-source

# Seed content (law/, defaults/) is tracked; user-specific content is not.
# /setup copies seed templates to the user's vault on first run.
knowledge/practice/
knowledge/matters/
knowledge/memory/

# Python bytecode (release.sh commits with git add -A)
__pycache__/
*.pyc

# Isolated dev worktrees (git worktree add / EnterWorktree)
.worktrees/
.claude/worktrees/

# End-to-end run scratch: the throwaway COUNSEL_OS_HOME, vault and traces
e2e/.tmp/

# brainstorm/SDD scratch
.superpowers/

# Imported public benchmarks (`counsel-os eval import`): local copies under
# their own licenses, never part of the repo (routing-and-evals spec §8).
evals/benchmarks/

# Local runs, user workspaces, signing material and generated reports.
# Synthetic test fixtures are source-built; never add imported client files.
evals/outputs/
.counsel/
.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db
*.counsel-backup
*.dmg
*.app/
*.p12
*.pfx
*.key
*.pem
.venv/
playwright-report/
test-results/
