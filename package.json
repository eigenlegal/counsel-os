{
  "name": "counsel-os",
  "version": "0.12.0",
  "description": "Legal operating system for Claude — contract review, negotiation, and practice management",
  "license": "MIT",
  "scripts": {
    "build:runtime": "bun scripts/build_runtime.ts",
    "build": "bun build --target=bun --compile -e electron -e 'chromium-bidi/*' -e playwright -e 'playwright/*' -e playwright-core -e 'playwright-core/*' browse/src/cli.ts --outfile browse/dist/browse",
    "content-version": "python3 scripts/bump_content_versions.py",
    "content:manifest": "bun scripts/gen_content_manifest.ts",
    "e2e": "bunx playwright test -c e2e/playwright.config.ts",
    "evals:self-test": "python3 scripts/run_evals.py --self-test",
    "evals:runtime": "python3 scripts/run_evals.py --generate --runner runtime",
    "evals:runner-test": "python3 scripts/eval_runtime_runner_test.py",
    "law:frontmatter": "python3 scripts/validate_law_frontmatter.py",
    "test": "bun test runtime/src browse/src scripts",
    "test:runtime": "bun test runtime/src",
    "test:server": "bun test browse/src",
    "typecheck": "tsc --noEmit -p browse/tsconfig.json",
    "typecheck:runtime": "tsc --noEmit -p runtime/tsconfig.json",
    "typecheck:ui": "tsc --noEmit -p runtime/ui",
    "ui:build": "cd runtime/ui && bun install --frozen-lockfile && bunx vite build",
    "ui:dev": "cd runtime/ui && bunx vite",
    "ui:test": "cd runtime/ui && bun test"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.72",
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/azure": "4.0.59",
    "@ai-sdk/cerebras": "3.0.43",
    "@ai-sdk/cohere": "4.0.37",
    "@ai-sdk/deepinfra": "3.0.43",
    "@ai-sdk/deepseek": "3.0.39",
    "@ai-sdk/fireworks": "3.0.46",
    "@ai-sdk/google": "4.0.62",
    "@ai-sdk/google-vertex": "5.0.74",
    "@ai-sdk/groq": "4.0.37",
    "@ai-sdk/mistral": "4.0.39",
    "@ai-sdk/openai": "^4.0.50",
    "@ai-sdk/openai-compatible": "^3.0.40",
    "@ai-sdk/perplexity": "4.0.38",
    "@ai-sdk/togetherai": "3.0.44",
    "@ai-sdk/xai": "4.0.53",
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.150.1",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@xmldom/xmldom": "0.9.12",
    "ai": "^7.0.83",
    "ai-sdk-ollama": "^4.2.0",
    "aws4fetch": "1.0.20",
    "fflate": "0.8.3",
    "playwright": "^1.50.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
